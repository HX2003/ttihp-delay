v {xschem version=3.4.8RC file_version=1.3}
G {}
K {type="tcleval([
if \{[info exists tcl_var_use_post_layout_netlist] && $tcl_var_use_post_layout_netlist == 1\} \{
    return "primitive"
\} else \{
    return "subcircuit"
\}])"
format="@name @@VDD @@VSS @@DLL_RESETN @@DELAY_OUT_LAST @@DELAY_IN @@DELAY_VBIASN @@DELAY_VBIASP @symname"
template="name=x1"}
V {}
S {}
F {}
E {}
L 4 -150 -10 -130 -10 {}
L 4 -150 10 -130 10 {}
L 4 -150 40 -130 40 {}
L 4 -150 60 -130 60 {}
L 4 -150 80 -130 80 {}
L 4 120 40 140 40 {}
L 4 120 60 140 60 {}
B 5 -152.5 -12.5 -147.5 -7.5 {name=VDD dir=in}
B 5 -152.5 7.5 -147.5 12.5 {name=VSS dir=in}
B 5 -152.5 37.5 -147.5 42.5 {name=DELAY_IN dir=in}
B 5 -152.5 57.5 -147.5 62.5 {name=DELAY_OUT_LAST dir=in}
B 5 -152.5 77.5 -147.5 82.5 {name=DLL_RESETN dir=in}
B 5 137.5 37.5 142.5 42.5 {name=DELAY_VBIASP dir=out}
B 5 137.5 57.5 142.5 62.5 {name=DELAY_VBIASN dir=out}
P 4 5 120 -20 -130 -20 -130 90 120 90 120 -20 {}
T {@symname} -128.5 94 0 0 0.3 0.3 {}
T {@name} 85 -42 0 0 0.2 0.2 {}
T {VDD} -125 -14 0 0 0.2 0.2 {}
T {VSS} -125 6 0 0 0.2 0.2 {}
T {tcleval([
if \{[info exists tcl_var_use_post_layout_netlist] && $tcl_var_use_post_layout_netlist == 1\} \{
    return "Using post-layout netlist
(with parasitics)"
\} else \{
    return ""
\}])} -128.5 124 0 0 0.3 0.3 {layer=21
weight=bold}
T {DELAY_IN} -125 36 0 0 0.2 0.2 {}
T {DELAY_OUT_LAST} -125 56 0 0 0.2 0.2 {}
T {DLL_RESETN} -125 76 0 0 0.2 0.2 {}
T {(input)} -35 36 0 0 0.2 0.2 {}
T {(input)} -35 56 0 0 0.2 0.2 {}
T {(input)} -35 76 0 0 0.2 0.2 {}
T {DLL CONTROLLER} -90 -10 0 0 0.3 0.3 {}
T {DELAY_VBIASP} 115 36 0 1 0.2 0.2 {}
T {DELAY_VBIASN} 115 56 0 1 0.2 0.2 {}
