v {xschem version=3.4.8RC file_version=1.3}
G {}
K {type="tcleval([
if \{[info exists tcl_var_use_post_layout_netlist] && $tcl_var_use_post_layout_netlist == 1\} \{
    return "primitive"
\} else \{
    return "subcircuit"
\}])"
format="@name @@VSS @@VDD @@DELAY_OUT_LAST @@DELAY_IN @@MUX_SEL0 @@MUX_SEL1 @@MUX_OUT @@MUX_SEL4 @@MUX_SEL2 @@MUX_SEL3 @@DELAY_VBIASN @@DELAY_VBIASP @symname"
template="name=x1"}
V {}
S {}
F {}
E {}
L 4 -110 -140 -90 -140 {}
L 4 -110 -120 -90 -120 {}
L 4 -110 -70 -90 -70 {}
L 4 -110 -50 -90 -50 {}
L 4 -110 -30 -90 -30 {}
L 4 100 -60 120 -60 {}
L 4 100 -40 120 -40 {}
L 4 -110 20 -90 20 {}
L 4 -110 40 -90 40 {}
L 4 -110 60 -90 60 {}
L 4 -110 80 -90 80 {}
L 4 -110 100 -90 100 {}
B 5 -112.5 -142.5 -107.5 -137.5 {name=VDD dir=in}
