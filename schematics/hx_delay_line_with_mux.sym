B 5 -112.5 37.5 -107.5 42.5 {name=MUX_SEL1 dir=in}
B 5 -112.5 57.5 -107.5 62.5 {name=MUX_SEL2 dir=in}
B 5 -112.5 77.5 -107.5 82.5 {name=MUX_SEL3 dir=in}
B 5 -112.5 97.5 -107.5 102.5 {name=MUX_SEL4 dir=in}
B 5 117.5 -62.5 122.5 -57.5 {name=MUX_OUT dir=out}
B 5 -112.5 -72.5 -107.5 -67.5 {name=DELAY_VBIASP dir=in}
B 5 -112.5 -52.5 -107.5 -47.5 {name=DELAY_IN dir=in}
B 5 -112.5 -32.5 -107.5 -27.5 {name=DELAY_VBIASN dir=in}
B 5 117.5 -42.5 122.5 -37.5 {name=DELAY_OUT_LAST dir=out}
P 4 5 100 -160 -90 -160 -90 120 100 120 100 -160 {}
T {@symname} -88.5 124 0 0 0.3 0.3 {}
T {@name} 65 -182 0 0 0.2 0.2 {}
T {VDD} -85 -144 0 0 0.2 0.2 {}
T {VSS} -85 -124 0 0 0.2 0.2 {}
T {tcleval([
if \{[info exists tcl_var_use_post_layout_netlist] && $tcl_var_use_post_layout_netlist == 1\} \{
    return "Using post-layout netlist
(with parasitics)"
\} else \{
    return ""
\}])} -88.5 144 0 0 0.3 0.3 {layer=21
weight=bold}
T {DELAY LINE
with MUX} -50 -150 0 0 0.4 0.4 {}
T {MUX_SEL0} -85 6 0 0 0.2 0.2 {}
T {MUX_SEL1} -85 26 0 0 0.2 0.2 {}
T {MUX_SEL2} -85 46 0 0 0.2 0.2 {}
